{
  "name": "pdffr-monorepo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build:lib": "npm run build -w pdffr",
    "build:packages": "npm run build -w pdffr-mcp -w pdffr-langchain -w pdffr-llamaindex",
    "build:demo": "vite build",
    "build": "npm run build:lib && npm run build:packages && npm run build:demo",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:lib && npm run build:packages && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^26.4.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "@langchain/core": "^0.3.0",
    "@llamaindex/core": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.20.0"
  },
  "license": "MIT"
}
