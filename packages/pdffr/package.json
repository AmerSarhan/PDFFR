{
  "name": "pdffr",
  "version": "0.3.0",
  "description": "PDF → Markdown decompiler for the browser and Node: native glyph geometry in milliseconds, render-diff-guided on-device OCR only where the text layer can't explain the ink.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "pdffr": "bin/pdffr.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/node.js",
    "./src/index.ts",
    "./src/node.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "cp ../../README.md README.md",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.60",
    "pdfjs-dist": ">=4.0.0",
    "tesseract.js": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    }
  },
  "keywords": [
    "pdf",
    "markdown",
    "pdf-to-markdown",
    "pdf-to-text",
    "ocr",
    "tesseract",
    "pdfjs",
    "document-parsing",
    "layout-analysis",
    "latex",
    "browser",
    "client-side",
    "privacy",
    "cli"
  ],
  "author": "Amer Sarhan <amer.sarhan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmerSarhan/PDFFR.git",
    "directory": "packages/pdffr"
  },
  "homepage": "https://github.com/AmerSarhan/PDFFR#readme",
  "bugs": {
    "url": "https://github.com/AmerSarhan/PDFFR/issues"
  }
}
