{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "pdffr": ["./packages/pdffr/src/index.ts"],
      "pdffr/node": ["./packages/pdffr/src/node.ts"]
    }
  },
  "include": ["packages/pdffr/src", "demo", "tests"]
}
