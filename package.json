{
  "name": "pdffr",
  "version": "0.2.0",
  "description": "PDF → Markdown decompiler for the browser and Node: native glyph geometry in milliseconds, render-diff-guided on-device OCR only where the text layer can't explain the ink.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "pdffr": "bin/pdffr.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/node.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.60",
    "pdfjs-dist": ">=4.0.0",
    "tesseract.js": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^26.4.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "pdf",
    "markdown",
    "pdf-to-markdown",
    "pdf-to-text",
    "ocr",
    "tesseract",
    "pdfjs",
    "document-parsing",
    "layout-analysis",
    "latex",
    "browser",
    "client-side",
    "privacy",
    "cli"
  ],
  "author": "Amer Sarhan <amer.sarhan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmerSarhan/PDDFR.git"
  },
  "homepage": "https://github.com/AmerSarhan/PDDFR#readme",
  "bugs": {
    "url": "https://github.com/AmerSarhan/PDDFR/issues"
  }
}
